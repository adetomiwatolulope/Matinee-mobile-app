# Server
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matinee?schema=public
# Optional read replica. When omitted, reads use DATABASE_URL.
DATABASE_READ_URL=
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
PRIMARY_READ_PIN_SECONDS=30

# Secrets - generate strong values for local .env and never commit .env
TOKEN_SECRET=replace-with-a-strong-secret
VERIFICATION_CODE_SECRET=replace-with-a-strong-secret

# Email (Nodemailer SMTP)
# Use your provider's SMTP host, port, username, password and sender address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Matinee <no-reply@example.com>"
APP_NAME=Matinee

# Verification code policy
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=6

# Durable email job worker
EMAIL_JOB_POLL_MS=5000
EMAIL_JOB_LEASE_MS=60000
EMAIL_JOB_MAX_ATTEMPTS=5
EMAIL_JOB_BATCH_SIZE=10

# Durable system job worker scaffold (webhooks, hold expiry, refunds)
SYSTEM_JOB_POLL_MS=5000
SYSTEM_JOB_LEASE_MS=60000
SYSTEM_JOB_MAX_ATTEMPTS=5
SYSTEM_JOB_BATCH_SIZE=10

# TMDB discovery integration
# Keep disabled until Product/Legal confirm commercial use, display rights and attribution.
TMDB_ENABLED=false
TMDB_COMMERCIAL_USE_APPROVED=false
TMDB_LOCAL_TESTING_ONLY=false
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_REQUEST_TIMEOUT_MS=5000
TMDB_MAX_RETRIES=3
TMDB_RETRY_BASE_MS=250
TMDB_RETRY_MAX_MS=2000

# Cache TTLs in seconds: details 7d, now playing 24h, search 1h.
TMDB_NOW_PLAYING_TTL_SECONDS=86400
TMDB_MOVIE_DETAILS_TTL_SECONDS=604800
TMDB_SEARCH_TTL_SECONDS=3600
TMDB_STALE_MAX_AGE_SECONDS=604800

# Redis cache and shared movie endpoint rate limit
REDIS_URL=redis://127.0.0.1:6379
MOVIE_API_RATE_LIMIT_MAX=60
MOVIE_API_RATE_LIMIT_WINDOW_SECONDS=60

# Local development only: process-local cache/rate-limit store when Redis is unavailable.
MOVIE_LOCAL_MEMORY_STORE=false
