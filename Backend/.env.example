# Server
PORT=3001
# Bind to all interfaces so LAN devices (Expo client) can reach the server
HOST=0.0.0.0

# Database (PostgreSQL) - update credentials/host/db as needed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matinee?schema=public

# Secrets - replace in local .env (never commit .env)
TOKEN_SECRET=replace-with-a-strong-secret

# Email (Nodemailer SMTP) - configure to send verification emails
# Examples: Gmail SMTP (use App Password), Mailtrap, Ethereal, or your provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Matinee <your-email@gmail.com>"
APP_NAME=Matinee

# Background email job worker (demo)
EMAIL_JOB_POLL_MS=5000
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=6
