# PostgreSQL connection for Prisma (demo). Update credentials/host/db as needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matinee?schema=public

# SMTP (used if running jobs from database context/scripts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Matinee <your-email@gmail.com>"
