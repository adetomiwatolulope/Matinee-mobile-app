// Demo schema (non-PRD). Do not treat as production-ready.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String    @id @default(cuid())
  name                           String
  email                          String    @unique
  passwordHash                   String
  emailVerified                  Boolean   @default(false)
  emailVerificationCodeHash      String?   @unique
  emailVerificationExpiresAt     DateTime?
  emailVerificationFailedAttempts Int      @default(0)
  emailVerificationJobId         String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
}

model EmailJob {
  id             String    @id @default(cuid())
  type           String
  status         String    @default("pending")
  reference      String?
  payload        Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  runAt          DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([status, leaseExpiresAt])
}

model RegistrationIdempotency {
  key            String    @id
  requestHash    String
  status         String    @default("pending")
  responseStatus Int?
  responseJson   Json?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([status, expiresAt])
}
